+++ b/source/UserMode/ExecMemory/code-patch-tool-darwin.cc
@@ -78,6 +78,22 @@ PUBLIC MemoryOperationError CodePatch(void *address, uint8_t *buffer, uint32_t b
   int offset = (int)((addr_t)address - page_aligned_address);

   static mach_port_t self_port = mach_task_self();
+#if defined(TARGET_ARCH_X64)
+  // Rosetta can keep executing an old translation after mach_vm_remap. Write
+  // through the target mapping so its self-modifying-code tracking sees it.
+  size_t patch_size = ALIGN_CEIL(offset + buffer_size, page_size);
+  kr = vm_protect(self_port, page_aligned_address, patch_size, FALSE,
+                  VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY);
+  if (kr != KERN_SUCCESS)
+    return kMemoryOperationError;
+  memcpy(address, buffer, buffer_size);
+  kr = vm_protect(self_port, page_aligned_address, patch_size, FALSE,
+                  VM_PROT_READ | VM_PROT_EXECUTE);
+  if (kr != KERN_SUCCESS)
+    return kMemoryOperationError;
+  ClearCache(address, (void *)((addr_t)address + buffer_size));
+  return kMemoryOperationSuccess;
+#endif
