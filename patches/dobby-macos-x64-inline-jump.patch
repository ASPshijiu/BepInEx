@@ -155,6 +155,10 @@ void NearMemoryArena::Destroy(MemoryChunk *chunk) {
 NearMemoryArena::NearMemoryArena() {
 }

+// Zero bytes at the end of an existing trampoline are still allocated memory.
+// Keep cave reservations even when their machine code contains a run of zeros.
+static std::vector<MemoryRange> reserved_caves;
+
 static addr_t search_near_blank_memory_chunk(addr_t pos, size_t alloc_range, int alloc_size) {
   addr_t min_page_addr, max_page_addr;
   min_page_addr = next_page(addr_sub(pos, alloc_range), OSMemory::AllocPageSize());
@@ -182,7 +186,23 @@ static addr_t search_near_blank_memory_chunk(addr_t pos, size_t alloc_range, int
             blank_chunk_addr += off;
           }
 #else
-          blank_chunk_addr = (uint8_t *)memmem(region.address, region.length, blank_memory, alloc_size);
+          auto cursor = (uint8_t *)region.address;
+          auto end = cursor + region.length;
+          while (cursor + alloc_size <= end) {
+            blank_chunk_addr = (uint8_t *)memmem(cursor, end - cursor, blank_memory, alloc_size);
+            if (!blank_chunk_addr)
+              break;
+            auto next = blank_chunk_addr;
+            for (const auto &reserved : reserved_caves) {
+              auto start = (uint8_t *)reserved.address;
+              if (blank_chunk_addr < start + reserved.length && start < blank_chunk_addr + alloc_size)
+                next = std::max(next, start + reserved.length);
+            }
+            if (next == blank_chunk_addr)
+              break;
+            cursor = next;
+            blank_chunk_addr = nullptr;
+          }
 #endif
           free(blank_memory);
           if (blank_chunk_addr)
@@ -269,6 +289,7 @@ search_once_more:
     chunk = new MemoryChunk;
     chunk->address = (void *)blank_chunk_addr;
     chunk->length = alloc_size;
+    reserved_caves.push_back({chunk->address, chunk->length});
     return chunk;
   }

